          "ui": { "layout": { "xs": 12, "sm": 12, "md": 6, "lg": 6 } }
        },
        { "name": "examTimeTill", "label": "Uhrzeit bis (8:00–16:00, 15-minütig)", "type": "select", "required": true,
          "options": ["08:00","08:15","08:30","08:45","09:00","09:15","09:30","09:45","10:00","10:15","10:30","10:45","11:00","11:15","11:30","11:45","12:00","12:15","12:30","12:45","13:00","13:15","13:30","13:45","14:00","14:15","14:30","14:45","15:00","15:15","15:30","15:45","16:00"],
          "placeholder": "z.B. auswählen …", "section": "Klausurtermin",
          "ui": { "layout": { "xs": 12, "sm": 12, "md": 6, "lg": 6 } }
        },
        { "name": "labs", "label": "Betroffenes Labor(e)", "type": "multiselect", "required": true,
          "options": ["TA A 209","A210","A214","A236","A142","A143","A013","A116","A216","A216b"], "section": "Betroffene Labore",
          "ui": { "layout": { "xs": 12, "sm": 12, "md": 12, "lg": 12 } }
        },
        { "name": "participants", "label": "Anzahl der Teilnehmenden", "type": "number", "required": true, "min": 1, "integer": true, "section": "Klausurtermin",
          "placeholder": "z.B. 24",
          "ui": { "layout": { "xs": 12, "sm": 12, "md": 6, "lg": 6 } }
        },
        { "name": "supportNeeded", "label": "Benötigte Unterstützung", "type": "multiselect", "required": true,
          "options": ["Aufsicht","technische Einrichtung","VDI-Login","sonstige"], "placeholder": "z.B. auswählen …",
          "ui": { "layout": { "xs": 12, "sm": 12, "md": 6, "lg": 6 } }
        },
        { "name": "techRequirements", "label": "Technische Anforderungen (z. B. Software, Netzwerkzugang)", "type": "textarea", "required": true, "minLength": 10, "section": "Technische Anforderungen",
          "placeholder": "z.B. SPSS installiert, Internetzugang gesperrt …",
          "ui": { "rows": 6, "layout": { "xs": 12, "sm": 12, "md": 12, "lg": 12 } }
        },
        { "name": "duration", "label": "Dauer der Unterstützung", "type": "text", "required": true,
          "placeholder": "z.B. 90 Minuten",
          "ui": { "layout": { "xs": 12, "sm": 12, "md": 6, "lg": 6 } }
        },
        { "name": "onSiteContact", "label": "Ansprechpartner während der Klausur", "type": "text", "required": true,
          "placeholder": "z.B. Dr. Muster",
          "ui": { "layout": { "xs": 12, "sm": 12, "md": 6, "lg": 6 } }
        }
      ]
    },
    {
      "key": "refund",
      "label": "Antrag auf Rückerstattung",
      "fields": [
