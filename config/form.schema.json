{
  "categories": [
    {
      "key": "Procurement",
      "label": "Beschaffung (Hard-/Software)",
      "fields": [
        { "name": "applicantTitle", "label": "Titel",                "type": "text",   "required": true, 
         "step": 1, "section": "Allgemein", "col": 6 },
        { "name": "applicantRole",  "label": "Rolle",                "type": "text",   "required": true, 
        "step": 1, "section": "Allgemein", "col": 8},
        { "name": "costCenter",     "label": "Kostenstelle",         "type": "text",   "required": true, 
        "step": 1, "section": "Allgemein", "col": 6 },
        { "name": "requestType",    "label": "Art des Antrags",      "type": "select", "required": true,
          "options": [ {"value":"Hardware","label":"Hardware"}, {"value":"Software","label":"Software"} ], 
          "step": 1, "section": "Allgemein", "col": 8
        },
        { "name": "description",    "label": "Beschreibung",         "type": "textarea","required": true, "minLength": 20, 
        "step": 1, "section": "Beschreibung", "col": 12 },
        { "name": "justification",  "label": "Begründung / Bedarf",  "type": "textarea","required": true, "minLength": 1,
        "step": 1, "section": "Beschreibung", "col": 12 },
        { "name": "quantity",       "label": "Anzahl / Menge",       "type": "number", "required": true, "min": 1, "integer": true,
        "step": 1, "section": "Beschreibung", "col": 6 },
        { "name": "unit",           "label": "Einheit",              "type": "text",   "required": true,
        "step": 1, "section": "Beschreibung", "col": 10 },
        { "name": "model",          "label": "Gewünschtes Modell / Hersteller", "type": "text",
        "step": 1, "section": "Beschreibung", "col": 12 },
        { "name": "price",          "label": "Preis / Kosten",       "type": "text",
        "step": 1, "section": "Beschreibung", "col": 8 },
        { "name": "productLink",    "label": "Link zum Produkt",     "type": "url", "required": false,
        "step": 1, "section": "Beschreibung", "col": 12 },
        { "name": "priority",       "label": "Priorität",            "type": "select", "required": true,
          "options": [ {"value":"low","label":"niedrig"}, {"value":"medium","label":"mittel"}, {"value":"high","label":"hoch"}, {"value":"very_high","label":"sehr hoch"} ],
          "step": 1, "section": "Details", "col": 8
        },
        { "name": "dueDate",        "label": "Fälligkeits-Datum",    "type": "date",
        "step": 1, "section": "Details", "col": 10 },
        { "name": "vergabeFile",    "label": "Vergabevermerk",       "type": "file",   "required": true, "accept": ["application/pdf","image/*"], "maxSizeMB": 10,
        "step": 1, "section": "Anhänge", "col": 12 },
        { "name": "belegFile",      "label": "Buchungsbeleg",        "type": "file",   "required": true, "accept": ["application/pdf","image/*"], "maxSizeMB": 10,
        "step": 1, "section": "Anhänge", "col": 12 }
      ]
    },
    {
      "key": "SoftwareInstall",
      "label": "Software-Installation/Update",
      "fields": [
        { "name": "softwareName",   "label": "Software: Name",  "type": "text",    "required": true },
        { "name": "softwareVersion","label": "Version",         "type": "text",    "required": true },
        { "name": "isLicensed",     "label": "Ist die Software lizenziert?", "type": "select",
          "options": [ {"value":"yes","label":"Ja"}, {"value":"no","label":"Nein"} ]
        },
        { "name": "licenseRequired","label": "Lizenz erforderlich?", "type": "select",
          "options": [ {"value":"yes","label":"ja"}, {"value":"no","label":"nein"}, {"value":"please_check","label":"bitte prüfen"} ],
          "requiredIf": { "field":"isLicensed", "eq":"yes" }
        },
        { "name": "licenseInfo",    "label": "Lizenzinformation / Schlüssel", "type": "textarea" },
        { "name": "installLocation","label": "Ort der Installation", "type": "select", "required": true,
          "options": [ {"value":"Lab","label":"Laborraum"}, {"value":"VDI","label":"VDI"} ]
        },
        { "name": "labRooms",       "label": "Labore (Mehrfachauswahl)", "type": "multiselect",
          "options": [ "A209","A210","A214","A236","A142","A143","A013" ],
          "requiredIf": { "field":"installLocation", "eq":"Lab" },
          "showIf":     { "field":"installLocation", "eq":"Lab" }
        },
        { "name": "vdiNote",        "label": "Zusatzangabe für VDI", "type": "text",
          "requiredIf": { "field":"installLocation", "eq":"VDI" },
          "showIf":     { "field":"installLocation", "eq":"VDI" }
        },
        { "name": "deadline",       "label": "Zeitpunkt / Frist", "type": "date", "required": true,
          "help": "Hinweis: während des Semesters keine Beschaffung"
        },
        { "name": "reason",         "label": "Grund für Installation/Update", "type": "textarea", "required": true }
      ]
    },
    {
      "key": "hardware-fault",
      "label": "Störmeldung: Hardware-/Peripheriedefekte in Laboren",
      "fields": [
        { "name": "lab", "label": "Betroffenes Labor", "type": "select", "required": true, "options": ["A209", "A210", "A214", "A236", "A142", "A143", "A013"] },

        { "name": "deviceType", "label": "Gerätetyp", "type": "select", "required": true, "options": ["Monitor", "PC", "Beamer", "Drucker", "Sonstiges"] },

        { "name": "inventoryNumber", "label": "Gerätekennung / Inventarnummer", "type": "text", "required": true },

        { "name": "inventoryPhoto", "label": "Foto der Inventarkennung", "type": "file", "required": false },

        { "name": "errorDescription", "label": "Beschreibung des Fehlers", "type": "textarea", "required": true, "minLength": 10 },

        { "name": "priority", "label": "Priorisierung", "type": "select", "required": true, "options": ["gering", "mittel", "hoch", "sehr hoch (Blocker)"] },

        { "name": "reproSteps", "label": "Wie ist der Fehler reproduzierbar?", "type": "textarea", "required": true, "minLength": 10 }
      ]
    },
    {
      "key": "software-fault",
      "label": "Störmeldung: Softwarefehler (Labor/VDI)",
      "fields": [
        { "name": "softwareNameVersion", "label": "Software-Name und Version", "type": "text", "required": true },

        { "name": "errorDescription", "label": "Fehlerbeschreibung (Was genau ist passiert?)", "type": "textarea", "required": true, "minLength": 10 },

        { "name": "occurenceTime", "label": "Zeitpunkt des Auftretens", "type": "text", "required": false },

        { "name": "place", "label": "Ort", "type": "select", "required": true, "options": ["Laborraum", "Gerät", "VDI"] },

        { "name": "screenshots", "label": "Screenshots (optional)", "type": "file", "required": false },

        { "name": "reproducible", "label": "Reproduzierbarkeit des Fehlers", "type": "select", "required": true, "options": ["Ja", "Nein"] },

        { "name": "reproSteps", "label": "Wenn ja: Wie ist der Fehler reproduzierbar?", "type": "textarea", "required": true, "minLength": 10, "showIf": { "field": "reproducible", "eq": "Ja" }, "requiredIf": { "field": "reproducible", "eq": "Ja" } }
      ]
    },
    {
      "key": "vm-provision",
      "label": "Antrag auf Bereitstellung von VMs",
      "fields": [
        { "name": "vmOs", "label": "Art des Betriebssystems der VM", "type": "select", "required": true, "options": ["Linux", "Windows"] },

        { "name": "purpose", "label": "Zweck der VM (z. B. Lehre, Projekt, Labor)", "type": "textarea", "required": true, "minLength": 10 },

        { "name": "responsibles", "label": "Verantwortlichkeit (Personen, durch Kommata getrennt)", "type": "text", "required": true },

        { "name": "name", "label": "Bezeichnung", "type": "text", "required": true },

        { "name": "description", "label": "Beschreibung (Aufgaben, Dienste, Prod/Test)", "type": "textarea", "required": true, "minLength": 10 },

        { "name": "disk", "label": "Speicherbedarf Festplatte", "type": "text", "required": true },
        { "name": "ram", "label": "Speicherbedarf RAM", "type": "text", "required": true },
        { "name": "cpuCores", "label": "Anzahl Prozessorkerne", "type": "number", "required": true, "min": 1, "integer": true },

        { "name": "isProject", "label": "Ist Zweck der VM ein Projekt?", "type": "select", "required": true, "options": ["Ja", "Nein"] },
        { "name": "projectEnd", "label": "Projektende", "type": "date", "required": true, "showIf": { "field": "isProject", "eq": "Ja" }, "requiredIf": { "field": "isProject", "eq": "Ja" } },

        { "name": "reachability", "label": "Erreichbarkeit der VM", "type": "select", "required": true, "options": ["Intern", "Extern"] }
      ]
    },
    {
      "key": "user-provision",
      "label": "Antrag auf Bereitstellung von Usern",
      "fields": [
        { "name": "accountCount", "label": "Anzahl benötigter Accounts", "type": "number", "required": true, "min": 1, "integer": true },

        { "name": "userType", "label": "Art des Users/Systems", "type": "select", "required": true, "options": ["Gast", "Klausur", "SAP", "VDI"] },

        { "name": "programDeptProf", "label": "Studiengang, Fachbereich, Professor", "type": "text", "required": true },

        { "name": "validFrom", "label": "Gültig ab", "type": "date", "required": true },
        { "name": "validTo", "label": "Gültig bis", "type": "date", "required": true },

        { "name": "purpose", "label": "Verwendungszweck", "type": "textarea", "required": true, "minLength": 10 },

        { "name": "systemsAccess", "label": "Zugang zu bestimmten Systemen notwendig? (z. B. SAP, Moodle)", "type": "text", "required": false },

        { "name": "autoDelete", "label": "Sollen die Accounts automatisch gelöscht werden?", "type": "select", "required": true, "options": ["Ja", "Nein"] },

        { "name": "contactPerson", "label": "Ansprechpartner für Rückfragen", "type": "text", "required": true }
      ]
    },
    {
      "key": "exam-support",
      "label": "Antrag auf Unterstützung bei Klausuren",
      "fields": [
        { "name": "examDate", "label": "Datum der Klausur", "type": "date", "required": true },

        { "name": "examTime", "label": "Uhrzeit (8:00–16:00, 15-minütig)", "type": "select", "required": true,
          "options": ["08:00","08:15","08:30","08:45","09:00","09:15","09:30","09:45","10:00","10:15","10:30","10:45","11:00","11:15","11:30","11:45","12:00","12:15","12:30","12:45","13:00","13:15","13:30","13:45","14:00","14:15","14:30","14:45","15:00","15:15","15:30","15:45","16:00"]
        },

        { "name": "labs", "label": "Betroffenes Labor(e)", "type": "multiselect", "required": true, "options": ["TA A 209","A210","A214","A236","A142","A143","A013","A116","A216","A216b"] },

        { "name": "participants", "label": "Anzahl der Teilnehmenden", "type": "number", "required": true, "min": 1, "integer": true },

        { "name": "supportNeeded", "label": "Benötigte Unterstützung", "type": "select", "required": true, "options": ["Aufsicht","technische Einrichtung","VDI-Login","sonstige"] },

        { "name": "techRequirements", "label": "Technische Anforderungen (z. B. Software, Netzwerkzugang)", "type": "textarea", "required": true, "minLength": 10 },

        { "name": "duration", "label": "Dauer der Unterstützung", "type": "text", "required": true },

        { "name": "onSiteContact", "label": "Ansprechpartner während der Klausur", "type": "text", "required": true }
      ]
    },
    {
      "key": "refund",
      "label": "Antrag auf Rückerstattung",
      "fields": [
        { "name": "applicantName", "label": "Antragsteller: Name", "type": "text", "required": true },
        { "name": "applicantTitle", "label": "Antragsteller: Titel", "type": "text", "required": true },
        { "name": "applicantRole", "label": "Antragsteller: Rolle", "type": "text", "required": true },

        { "name": "costCenter", "label": "Kostenstelle", "type": "text", "required": true },

        { "name": "purchaseDescription", "label": "Beschreibung der getätigten Beschaffung", "type": "textarea", "required": true, "minLength": 10 },
        { "name": "justification", "label": "Begründung / Bedarf", "type": "textarea", "required": true, "minLength": 10 },

        { "name": "quantity", "label": "Anzahl / Menge", "type": "number", "required": true, "min": 1, "integer": true },
        { "name": "unit", "label": "Einheit", "type": "text", "required": true },

        { "name": "manufacturer", "label": "Hersteller", "type": "text", "required": false },

        { "name": "amount", "label": "Betrag", "type": "number", "required": true, "min": 0 },

        { "name": "awardNote", "label": "Vergabevermerk", "type": "file", "required": true },
        { "name": "bookingReceipt", "label": "Buchungsbeleg", "type": "file", "required": true }
      ]
    }
  ],
  "baseFields": [
    { "name":"name",    "label":"Name",    "type":"text",     "required": true, "minLength": 2 },
    { "name":"email",   "label":"E-Mail",  "type":"email",    "required": true },
    { "name":"subject", "label":"Betreff", "type":"text",     "required": true, "minLength": 3 },
    { "name": "priority", "label": "Priorität", "type": "select",
      "options": ["low", "medium", "high"],
      "required": true,
      "step": 1, "section": "Ticket-Details", "col": 3
    },
    { "name": "subject", "label": "Betreff", "type": "text",
      "required": true,
      "step": 1, "section": "Ticket-Details", "col": 9
    }
  ]
}
