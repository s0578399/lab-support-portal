# ============================
# Environment Beispiel-Datei
# ============================
# Kopiere Sie diese Datei z. B. nach `.env.vm` oder `.env.prod`
# und trage dort die echten Werte ein.
# ============================

# CORS: erlaubte Ursprünge (kommagetrennt)
# Für die VM: Domain der Test-Instanz + lokal
ALLOWED_ORIGINS=http://it-service-wi-test.f4.htw-berlin.de,https://it-service-wi-test.f4.htw-berlin.de,http://localhost

# Backend-Port (normalerweise 3000)
PORT=3000

# Node Environment
NODE_ENV=production

# ============================
# Mail-Einstellungen
# ============================

# Mail-Transport
# - Für lokale Tests mit Mailhog:
#   SMTP_HOST=mailhog
#   SMTP_PORT=1025
# - Für Uni-SMTP:
#   SMTP_HOST=smtp.htw-berlin.de
#   SMTP_PORT=587
SMTP_HOST=mailhog
SMTP_PORT=1025

# TLS/SSL: true = SMTPS (465), false = STARTTLS (587/1025)
SMTP_SECURE=false

# SMTP-Login (nur bei Uni-SMTP relevant)
SMTP_USER=
SMTP_PASS=

# Absender & Empfänger
MAIL_FROM="Ticket Portal <no-reply@example.org>"
MAIL_TO="support@example.org"
