# ============================
# Environment Beispiel (Prod)
# ============================
# Diese Datei ist für das Deployment auf der Uni-VM gedacht.
# Keine Mailhog-Container mehr, stattdessen Uni-SMTP.
# ============================

# CORS: erlaubte Ursprünge (Prod nur die Domain mit HTTPS)
ALLOWED_ORIGINS=https://it-service-wi-test.f4.htw-berlin.de

# Backend-Port (normalerweise 3000)
PORT=3000

# Node Environment
NODE_ENV=production

# ============================
# Mail-Einstellungen (Uni-SMTP)
# ============================

# Uni-SMTP-Server (Beispiel: HTW Berlin)
SMTP_HOST=smtp.htw-berlin.de
SMTP_PORT=587

# TLS/SSL: true = SMTPS (Port 465), false = STARTTLS (587)
SMTP_SECURE=false

# SMTP-Login (Pflicht bei Uni-SMTP)
SMTP_USER=<dein-service-user>
SMTP_PASS=<dein-passwort>

# Absender & Empfänger
MAIL_FROM="Ticket Portal <no-reply@htw-berlin.de>"
MAIL_TO="it-support@htw-berlin.de"
